<script>
  const targets = [...document.querySelectorAll<HTMLElement>('#main [data-reveal]')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const animations = new Map<HTMLElement, Animation>();
  const root = document.documentElement;
  clearTimeout(Number(root.dataset.revealFallback));
  delete root.dataset.revealFallback;
  // The head script hides pending items before first paint; no-JS stays visible.
  if (root.classList.contains('reveal-ready') && !reducedMotion.matches) {
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const element = entry.target as HTMLElement;
        observer.unobserve(element);
        element.dataset.revealed = 'true';
        if (reducedMotion.matches || element.contains(document.activeElement)) continue;
        const group = element.closest('[data-reveal-group]');
        const siblings = group ? [...group.querySelectorAll('[data-reveal]')] : [];
        const delay = Number(element.dataset.revealDelay ?? (group ? (Math.max(siblings.indexOf(element), 0) + 1) * 100 : 0));
        const from = element.dataset.reveal === 'zoom' ? 'scale(0.6)' : 'translateY(100px)';
        const animation = element.animate([
          { opacity: 0, transform: from },
          { opacity: 1, transform: 'none' },
        ], { duration: 600, delay, easing: 'ease-in-out', fill: 'backwards' });
        animations.set(element, animation);
        animation.finished.then(() => animations.delete(element), () => animations.delete(element));
      }
    }, { threshold: 0, rootMargin: '0px 0px -120px 0px' });
    targets.forEach(element => observer.observe(element));
    document.addEventListener('focusin', event => {
      if (!(event.target instanceof Element)) return;
      for (const element of targets) {
        if (!element.contains(event.target)) continue;
        observer.unobserve(element);
        element.dataset.revealed = 'true';
        animations.get(element)?.cancel();
      }
    });
    reducedMotion.addEventListener('change', () => {
      if (!reducedMotion.matches) return;
      observer.disconnect();
      root.classList.remove('reveal-ready');
      animations.forEach(animation => animation.cancel());
      animations.clear();
    });
  } else {
    root.classList.remove('reveal-ready');
  }
</script>
