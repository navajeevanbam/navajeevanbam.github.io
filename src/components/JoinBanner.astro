---
import { url } from '../lib/site';
import Icon from './Icon.astro';
---
<section class="container section-space"><div class="join-banner" data-reveal><div><p class="eyebrow">A place for your kindness</p><h2>Small acts. Lasting change.</h2><p>Give your time, share what you can, or simply start a conversation.<br class="hidden md:block"/> A better tomorrow begins with us.</p></div><div class="flex flex-wrap gap-3"><a class="button button-saffron" href={url('donation/')}>Make a contribution <Icon name="heart"/></a><a class="button button-outline-light" href={url('contact/')}>Become a volunteer <Icon name="arrow"/></a></div></div></section>
