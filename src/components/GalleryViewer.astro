---
interface Props { title: string; }
const { title } = Astro.props;
---
<dialog id="gallery-viewer" aria-labelledby="viewer-title" aria-describedby="viewer-caption">
  <div class="viewer-shell">
    <div class="viewer-top"><h2 id="viewer-title">{title}</h2><button type="button" data-close autofocus aria-label="Close photo viewer">Close ×</button></div>
    <div class="viewer-image" data-image-slot></div>
    <div class="viewer-bottom"><p id="viewer-caption"></p><div class="viewer-controls"><button type="button" data-previous aria-label="Previous photo">←</button><span data-counter role="status" aria-live="polite"></span><button type="button" data-next aria-label="Next photo">→</button></div></div>
  </div>
</dialog>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#gallery-viewer')!;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-gallery-photo]')];
  const close = dialog.querySelector<HTMLButtonElement>('[data-close]')!;
  const previous = dialog.querySelector<HTMLButtonElement>('[data-previous]')!;
  const next = dialog.querySelector<HTMLButtonElement>('[data-next]')!;
  const slot = dialog.querySelector<HTMLElement>('[data-image-slot]')!;
  const caption = dialog.querySelector<HTMLElement>('#viewer-caption')!;
  const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
  let index = 0;
  let opener: HTMLAnchorElement | undefined;
  let scrollPosition = 0;
  let originalBodyStyle: string | null = null;
  let originalOverflow = '';
  let isViewing = false;
  function showPhoto(value: number) {
    index = (value + links.length) % links.length;
    const link = links[index];
    const image = link.querySelector('img')!.cloneNode() as HTMLImageElement;
    image.loading = 'eager';
    image.className = '';
    slot.replaceChildren(image);
    caption.textContent = link.dataset.caption ?? image.alt;
    counter.textContent = `${index + 1} of ${links.length}`;
    previous.hidden = next.hidden = links.length < 2;
  }
  links.forEach((link, i) => link.addEventListener('click', event => {
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0 || !dialog.showModal) return;
    event.preventDefault();
    opener = link;
    showPhoto(i);
    isViewing = true;
    scrollPosition = scrollY;
    originalBodyStyle = document.body.getAttribute('style');
    originalOverflow = document.documentElement.style.overflow;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollPosition}px`;
    document.body.style.width = '100%';
    document.documentElement.style.overflow = 'hidden';
    dialog.showModal();
    close.focus();
  }));
  function closeViewer() { dialog.close(); restorePage(); }
  close.addEventListener('click', closeViewer);
  dialog.addEventListener('cancel', event => { event.preventDefault(); closeViewer(); });
  previous.addEventListener('click', () => showPhoto(index - 1));
  next.addEventListener('click', () => showPhoto(index + 1));
  dialog.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault(); showPhoto(index + (event.key === 'ArrowLeft' ? -1 : 1));
    }
    if (event.key === 'Tab') {
      const controls = [close, previous, next].filter(button => !button.hidden);
      if (event.shiftKey && document.activeElement === controls[0]) { event.preventDefault(); controls.at(-1)!.focus(); }
      else if (!event.shiftKey && document.activeElement === controls.at(-1)) { event.preventDefault(); close.focus(); }
    }
  });
  function restorePage() {
    if (!isViewing) return;
    isViewing = false;
    if (originalBodyStyle === null) document.body.removeAttribute('style');
    else document.body.setAttribute('style', originalBodyStyle);
    document.documentElement.style.overflow = originalOverflow;
    window.scrollTo({ top: scrollPosition, behavior: 'instant' });
    opener?.focus({ preventScroll: true });
    slot.replaceChildren();
  }
  dialog.addEventListener('close', () => { if (!dialog.open) restorePage(); });
</script>
<style>
  dialog { position:fixed; inset:0; margin:0; width:100%; max-width:none; height:100dvh; max-height:none; border:0; padding:clamp(16px,3vw,40px); background:#14291f; color:#faf8f1; }
  dialog::backdrop { background:#14291f; }
  .viewer-shell { height:100%; display:flex; flex-direction:column; gap:20px; max-width:1500px; margin:auto; }
  .viewer-top,.viewer-bottom { display:flex; align-items:center; justify-content:space-between; gap:20px; flex:none; }
  .viewer-top h2 { font-size:clamp(18px,2vw,26px); color:#faf8f1; }
  button { border:1px solid #faf8f160; border-radius:999px; min-width:48px; min-height:48px; padding:10px 16px; color:#faf8f1; cursor:pointer; flex:none; }
  button:hover { background:#ffffff18; }
  button:focus-visible { outline:3px solid #f4b55b; outline-offset:4px; }
  .viewer-image { flex:1; min-height:0; display:flex; align-items:center; justify-content:center; }
  .viewer-image :global(img) { width:100%; height:100%; object-fit:contain; }
  .viewer-controls { display:flex; align-items:center; gap:20px; white-space:nowrap; }
  #viewer-caption { font-size:14px; max-width:700px; }
  @media(max-width:767px) { .viewer-bottom { flex-direction:column; text-align:center; gap:12px; } .viewer-top { align-items:flex-start; } }
</style>
