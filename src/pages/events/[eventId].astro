---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import { contentImage } from '../../lib/content-images';
import Icon from '../../components/Icon.astro';
import EventCard from '../../components/EventCard.astro';
import { url, dateLabel } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('events')).map(event => ({ params: { eventId: event.id }, props: { event } })); }
const { event } = Astro.props;
const cover = await contentImage(event);
const { Content } = await render(event);
const related = (await getCollection('events')).filter(e => e.id !== event.id && e.data.status === event.data.status).slice(0,2);
---
<Layout title={event.data.title} description={event.data.excerpt} active="events/" image={cover}>
  <section class="container pt-10 pb-9 md:pt-14" data-reveal><nav class="breadcrumbs" aria-label="Breadcrumb"><a href={url()}>Home</a><span aria-hidden="true">/</span><a href={url('events/')}>Events</a><span aria-hidden="true">/</span><span aria-current="page">{event.data.title}</span></nav><p class="eyebrow">{event.data.category} · {event.data.status === 'upcoming' ? 'Upcoming gathering' : 'Past gathering'}</p><h1 class="max-w-4xl">{event.data.title}</h1><p class="intro-copy">{event.data.excerpt}</p></section>
  <div class="container" data-reveal><Photo photo={cover} eager class="max-h-[540px] w-full aspect-[1.6] md:aspect-[2.3] rounded-3xl"/></div>
  <section class="container section-space"><div class="grid gap-12 lg:grid-cols-[1.4fr_.8fr] lg:gap-20"><div data-reveal>{event.data.sample && <p class="demo-note mb-8">Illustrative event. This is sample content, not a confirmed gathering or a record of an event that took place.</p>}<div class="prose"><Content/></div></div><aside data-reveal data-reveal-delay="250" class="h-fit rounded-2xl border border-forest/15 bg-white/50 p-7"><p class="eyebrow">The gathering at a glance</p><div class="space-y-5"><div class="flex items-center gap-3"><Icon name="calendar"/><div><p class="text-sm font-semibold">{dateLabel(event.data.date)}</p>{event.data.sample && <p class="text-xs text-muted">Illustrative date</p>}</div></div>{event.data.time && <div class="flex items-center gap-3"><Icon name="clock"/><p class="text-sm">{event.data.time}</p></div>}<div class="flex items-center gap-3"><Icon name="pin"/><p class="text-sm">{event.data.location}</p></div></div>{event.data.schedule?.length && <div><h2 class="mt-8 border-t border-forest/15 pt-7 text-2xl">A little plan for the day</h2><ol class="mt-5 space-y-5">{event.data.schedule.map(item => <li class="border-l-2 border-saffron pl-4"><p class="text-xs font-semibold">{item.time}</p><p class="mt-1 text-sm text-muted">{item.activity}</p></li>)}</ol></div>}<a class="button button-dark mt-8 w-full" href={url('contact/')}>{event.data.status === 'upcoming' ? 'Ask about taking part' : 'Explore future opportunities'}<Icon name="arrow"/></a>{event.data.sample && <p class="mt-3 text-center text-[10px] text-muted">Participation details will be confirmed later.</p>}</aside></div></section>
  <section class="container pb-18"><div class="section-heading" data-reveal><h2>More ways to come together.</h2><a href={url('events/')} class="text-link">All gatherings <Icon name="arrow"/></a></div><div class="grid gap-7 md:grid-cols-2">{related.map(item => <EventCard event={item}/>)}</div></section>
</Layout>
