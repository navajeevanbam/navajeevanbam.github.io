---
import { site } from '../config';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import EventCard from '../components/EventCard.astro';
import StoryCard from '../components/StoryCard.astro';
import JoinBanner from '../components/JoinBanner.astro';
import { programs } from '../config';
import { url } from '../lib/site';
const events = (await getCollection('events')).filter(e => e.data.status === 'upcoming').sort((a,b) => +a.data.date - +b.data.date).slice(0,3);
const stories = (await getCollection('stories')).sort((a,b) => +b.data.date - +a.data.date).slice(0,3);
---
<Layout title="A little care. A new beginning." description={`Welcome to ${site.name}. Discover a community rooted in compassion, education, nourishment, elder care, and wellbeing.`} active="">
  <section class="container pt-10 pb-14 md:pt-16 md:pb-20">
    <div class="grid items-center gap-10 lg:grid-cols-[.94fr_1.06fr] lg:gap-12">
      <div class="py-3 lg:py-9"><p class="eyebrow text-[#7a683e]">Together, we make a difference</p><h1>A little care.<br/>A <em class="font-normal text-[#8f642d]">new beginning.</em></h1><p class="mt-7 max-w-[420px] text-[15px] leading-7 text-muted">Every person deserves a place to belong. At {site.name}, we nurture hope through care, compassion, and the power of community.</p><div class="mt-8 flex flex-wrap gap-3"><a href={url('donation/')} class="button button-dark">Be someone’s new beginning <Icon name="arrow"/></a><a href={url('about/')} class="button button-outline">Our story</a></div><div class="mt-9 flex items-center gap-3"><span class="flex size-10 items-center justify-center rounded-full border border-forest/15"><Icon name="heart" class="size-4"/></span><p class="text-[11px] leading-relaxed text-muted">Rooted in compassion.<br/><strong class="font-medium text-forest">Growing stronger, together.</strong></p></div></div>
      <div class="relative pb-7 pl-3 sm:pl-6"><Photo name="community" eager class="hero-photo aspect-[1.06] w-full"/><div class="hero-note absolute -bottom-1 left-0 flex max-w-[85%] items-center gap-4 rounded-xl border border-forest/5 bg-[#fffdf7] px-5 py-4 sm:px-6"><span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#f5e9cc] text-[#936c29]"><Icon name="sun"/></span><div><p class="font-serif text-[16px] leading-snug">Where kindness feels like home.</p><p class="mt-1 text-[10px] tracking-wide text-muted">One community. Countless new beginnings.</p></div></div><div class="absolute -right-2 -top-4 flex size-18 items-center justify-center rounded-full border-[5px] border-cream bg-saffron md:size-22" aria-hidden="true"><Icon name="heart" class="size-8 -rotate-12"/></div></div>
    </div>
  </section>
  <section class="border-y border-forest/10 bg-[#f0f0e5]"><div class="container py-8"><div class="grid grid-cols-2 gap-y-7 md:grid-cols-4"><div class="text-center"><p class="font-serif text-3xl md:text-4xl">1,200<span class="text-[#9b7437]">+</span></p><p class="mt-1 text-[11px] text-muted">Lives touched with care</p></div><div class="border-l border-forest/15 text-center"><p class="font-serif text-3xl md:text-4xl">15,000<span class="text-[#9b7437]">+</span></p><p class="mt-1 text-[11px] text-muted">Warm meals shared</p></div><div class="md:border-l border-forest/15 text-center"><p class="font-serif text-3xl md:text-4xl">80<span class="text-[#9b7437]">+</span></p><p class="mt-1 text-[11px] text-muted">Hearts volunteering</p></div><div class="border-l border-forest/15 text-center"><p class="font-serif text-3xl md:text-4xl">4</p><p class="mt-1 text-[11px] text-muted">Ways we nurture hope</p></div></div><p class="mt-5 text-center text-[9px] tracking-wide text-muted">Illustrative impact figures · Our real journey will be shared here.</p></div></section>
  <section class="container section-space"><div class="grid items-center gap-10 md:grid-cols-2 lg:gap-20"><div class="relative"><Photo name="elders" class="aspect-[1.2] w-full rounded-2xl"/><div class="absolute -bottom-4 right-4 rounded-xl bg-[#e9dcb8] px-6 py-5 sm:right-7"><span class="font-serif text-xl">Care beyond charity.</span><span class="mt-1 block text-[10px] uppercase tracking-[.14em]">Connection. Dignity. Belonging.</span></div></div><div class="pt-5 md:pt-0"><p class="eyebrow">The heart of {site.shortName}</p><h2>Not just a helping hand.<br/>A place to call home.</h2><p class="mt-6 text-sm text-muted">We believe meaningful change begins with something simple: showing up for one another. A shared meal. A patient conversation. A child discovering the joy of learning.</p><p class="mt-4 text-sm text-muted">{site.name} brings these moments together, creating a community where everyone is seen, supported, and valued.</p><a href={url('about/')} class="text-link mt-7 border-b border-forest/25 pb-2">Get to know our Ashram <Icon name="arrow"/></a></div></div></section>
  <section class="bg-[#efeee4] section-space"><div class="container"><div class="section-heading"><div><p class="eyebrow">How we care</p><h2>Many needs. One shared purpose.</h2></div><p class="max-w-sm text-sm text-muted">Small, thoughtful actions that help our neighbours live fuller, healthier, happier lives.</p></div><div class="program-grid grid md:grid-cols-4">{programs.map((program, index) => <article class="py-6 md:py-0 md:px-5 first:pl-0 last:pr-0"><div class="mb-6 flex items-center justify-between"><span class="flex size-12 items-center justify-center rounded-full bg-[#e0e3d4]"><Icon name={program.icon}/></span><span class="font-serif text-sm text-muted">0{index+1}</span></div><p class="mb-2 text-[9px] uppercase tracking-[.15em] text-muted">{program.category}</p><h3 class="text-xl">{program.title}</h3><p class="mt-4 text-xs text-muted">{program.description}</p><a href={url(`about/#${program.image}`)} class="text-link mt-6">Learn more <Icon name="arrow"/></a></article>)}</div></div></section>
  <section class="container section-space"><div class="section-heading"><div><p class="eyebrow">Come together. Give together.</p><h2>Good things happen when we gather.</h2></div><a href={url('events/')} class="text-link">View all events <Icon name="arrow"/></a></div><div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{events.map(event => <EventCard event={event}/>)}</div></section>
  <section class="container pb-4 md:pb-8"><div class="relative isolate overflow-hidden rounded-3xl bg-forest"><Photo name="volunteers" class="absolute inset-0 -z-20 size-full opacity-35"/><div class="absolute inset-0 -z-10 bg-gradient-to-r from-forest/95 via-forest/70 to-transparent"></div><div class="max-w-2xl px-7 py-14 text-white md:px-14 md:py-18"><p class="eyebrow text-saffron">Your time is a beautiful gift</p><h2>You don’t need to change<br/>the world in a day.</h2><p class="mt-5 max-w-md text-sm text-white/85">Just bring your kindness. Read a story, share a skill, plant a seed, or spend an afternoon listening. There’s a place for you here.</p><a class="button button-saffron mt-7" href={url('contact/')}>Find your way to give back <Icon name="arrow"/></a></div></div></section>
  <section class="container section-space"><div class="section-heading"><div><p class="eyebrow">Notes from our community</p><h2>Little stories. A lot of heart.</h2></div><a href={url('stories/')} class="text-link">Explore all stories <Icon name="arrow"/></a></div><div class="grid gap-9 md:grid-cols-2 lg:grid-cols-3">{stories.map(story => <StoryCard story={story}/>)}</div></section>
  <JoinBanner/>
</Layout>
