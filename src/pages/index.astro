---
import { getEntry } from 'astro:content';
import { site } from '../config';
import { home } from '../config/home';
import Layout from '../layouts/Layout.astro';
import HomeSlider from '../components/HomeSlider.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { url, dateLabel } from '../lib/site';
const projects = await Promise.all(home.projects.map(async id => { const entry = await getEntry('events', id); if (!entry || entry.data.sample) throw new Error(`Missing reference project: ${id}`); return entry; }));
for (const service of home.services) { const entry = await getEntry('stories', service.id); if (!entry || entry.data.sample) throw new Error(`Missing reference service: ${service.id}`); }
---
<Layout scrollReveal title="A little care. A new beginning." description={`A home for care, learning, and belonging. Discover the people and programmes of ${site.name}.`} image="reference-children" active="">
  <HomeSlider/>
  <section id="about" class="container section-space home-about" aria-labelledby="about-title">
    <header class="about-heading" data-reveal><p class="eyebrow">{site.name}</p><h2 id="about-title">About Us</h2></header>
    <div class="about-images" data-reveal data-reveal-delay="100">{home.about.images.map(photo => <figure><Photo name={photo.image} class="about-photo"/><figcaption>{photo.caption}</figcaption></figure>)}<p class="about-founded"><span>Since 2012</span> A home for care, learning, and belonging.</p></div>
    <div class="about-copy" data-reveal data-reveal-delay="250"><h3 class="whitespace-pre-line">{home.about.title}</h3>{home.about.paragraphs.map(paragraph => <p class="mt-5 text-sm text-muted">{paragraph}</p>)}<a class="text-link mt-7" href={url('#services')}>Discover how we care <Icon name="arrow"/></a></div>
  </section>
  <section id="projects" class="section-space projects-section"><div class="container">
    <div class="section-heading" data-reveal><div><p class="eyebrow">Care in action</p><h2>Projects & Programs</h2></div><a class="text-link" href={url('events/')}>Explore all events <Icon name="arrow"/></a></div>
    <div class="project-grid" data-reveal-group>{projects.map((project, i) => <article class="project-card" data-reveal><div class="project-top"><span class="project-number">0{i + 1}</span><Icon name={['sun','heart','plus'][i]} class="size-8"/></div><p class="card-category">{dateLabel(project.data.date)} · Past project</p><h3><a href={url(`events/${project.id}/`)}>{project.data.title}</a></h3><p class="card-description">{project.data.excerpt}</p><a class="text-link mt-7" href={url(`events/${project.id}/`)}>Read about this project <Icon name="arrow"/></a></article>)}</div>
  </div></section>
  <section class="container section-space"><div class="section-heading" data-reveal><div><p class="eyebrow">What guides us</p><h2>One shared purpose.<br/>Many ways to care.</h2></div><p class="max-w-sm text-sm text-muted">Compassion is at the heart of the everyday things we do.</p></div><div class="values-grid" data-reveal-group>{home.values.map(value => <article data-reveal><div class="value-icon"><Icon name={value.icon} class="size-7"/></div><h3>{value.title}</h3><p class="card-description">{value.description}</p></article>)}</div></section>
  <section id="services" class="section-space services-section"><div class="container"><div class="section-heading" data-reveal><div><p class="eyebrow">Our five service activities</p><h2>Care, in all its forms.</h2></div><a href={url('stories/')} class="text-link">Stories from the Ashram <Icon name="arrow"/></a></div><div class="services-grid" data-reveal-group>{home.services.map((service, i) => <article class="service-card" data-reveal><a class="service-image" href={url(`stories/${service.id}/`)} tabindex="-1" aria-hidden="true"><Photo name={service.image}/></a><div class="service-body"><p class="card-category">0{i + 1} / Our services</p><h3><a href={url(`stories/${service.id}/`)}>{service.title}</a></h3><p class="card-description">{service.description}</p><a href={url(`stories/${service.id}/`)} class="text-link mt-6">Discover this service <Icon name="arrow"/></a></div></article>)}</div></div></section>
  <section id="team" class="container section-space"><div class="section-heading" data-reveal><div><p class="eyebrow">The people behind the care</p><h2>Our Management Team</h2></div><p class="max-w-sm text-sm text-muted">A shared commitment to service, dignity, and the Ashram community.</p></div><div class="team-grid" data-reveal-group>{home.team.map((member, i) => <article data-reveal="zoom" data-reveal-delay={(i + 1) * 200}><div class="team-portrait"><Photo name={member.image}/></div><h3 class="mt-6">{member.name}</h3><p class="mt-2 max-w-xs text-sm text-muted">{member.role}</p></article>)}</div></section>
  <section class="container pb-8"><div class="home-donation" data-reveal><div><p class="eyebrow">Your kindness makes room for more</p><h2 class="whitespace-pre-line">{home.donation.title}</h2><p>{home.donation.description}</p><a class="button button-saffron mt-7" href={url('donation/')}>{home.donation.cta}<Icon name="heart"/></a></div><Photo name="reference-meals" class="donation-photo"/></div></section>
  <section class="container section-space home-contact" data-reveal><div><p class="eyebrow">Let’s connect</p><h2>{home.contact.title}</h2><p class="mt-5 text-sm text-muted">{home.contact.description}</p><a class="button button-dark mt-7" href={url('contact/')}>{home.contact.cta}<Icon name="arrow"/></a></div><address class="contact-details"><div><p class="card-category">Visit our Ashram</p>{site.addressLines.map(line => <p>{line}</p>)}</div><div><p class="card-category">Call us</p>{site.phones.map(phone => <a href={phone.href}>{phone.label}</a>)}</div><div><p class="card-category">Write to us</p>{site.emails.map(email => <a href={`mailto:${email}`}>{email}</a>)}</div></address></section>
  <ScrollReveal/>
</Layout>
