---
import { site } from '../config';
import { donation } from '../config/donation';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { url } from '../lib/site';
const rupees = (amount: number) => `₹${amount.toLocaleString('en-IN')}`;
---
<Layout title="Donate to a new beginning" description={`Support meals, education, care for older women, and Navajeevan Goshala. Find sponsorship options and donation details for ${site.name}.`} active="donation/" image="donation-meals">
  <section class="container section-space donation-intro">
    <div data-reveal><p class="eyebrow">Give with love · {site.name}</p><h1>Your kindness.<br/>Someone’s new beginning.</h1><p class="intro-copy">A meal shared. A child learning. A place to call home. Your support helps sustain everyday care within and around our Ashram.</p><div class="mt-8 flex flex-wrap gap-3"><a class="button button-dark" href="#ways-to-give">Make a donation <Icon name="heart"/></a><a class="button button-outline" href="#sponsorships">Explore sponsorships <Icon name="arrow"/></a></div><p class="mt-6 text-xs text-muted">Mark a special occasion with an act of care.</p></div>
    <figure data-reveal data-reveal-delay="250"><Photo name="donation-meals" eager class="w-full rounded-3xl aspect-[1.2]"/><figcaption class="mt-3 text-xs text-muted">Annadaan — a shared meal at Navajeevan Seva Trust.</figcaption></figure>
  </section>

  <section id="sponsorships" class="section-space bg-[#efeee4]"><div class="container">
    <div class="section-heading" data-reveal><div><p class="eyebrow">Choose a way to care</p><h2>Sponsor a moment.<br/>Support everyday life.</h2></div><p class="max-w-sm text-sm text-muted">Support meals and programmes at the Ashram. Call us to arrange a date or discuss your contribution.</p></div>
    <div class="sponsorship-grid">{donation.sponsorships.map((item, index) => <article class="sponsorship-card" data-reveal data-reveal-delay={(index % 3) * 100}><div class="mb-6 flex size-12 items-center justify-center rounded-full bg-[#e8e8d7]"><Icon name={item.icon}/></div><h3>{item.title}</h3><p class="card-description">{item.description}</p><dl class="sponsorship-prices">{item.options.map(option => <div data-sponsor-amount={option.amount}><dt>{option.label}</dt><dd><strong>{rupees(option.amount)}</strong><span>{option.period}</span></dd></div>)}</dl></article>)}</div>
    <div class="mt-8 flex flex-wrap items-center justify-between gap-4"><p class="text-sm text-muted">Have a special day in mind? We’d love to help you plan it.</p><a class="text-link" href={site.phones[0].href}>Call {site.phones[0].label} <Icon name="phone"/></a></div>
  </div></section>

  <section id="ways-to-give" class="container section-space">
    <div class="section-heading" data-reveal><div><p class="eyebrow">Turn kindness into care</p><h2>Ways to make a donation</h2></div><p class="max-w-sm text-sm text-muted">Use the Ashram’s QR code or one of the bank accounts below. Payments are made through your payment or banking app.</p></div>
    <div class="donation-qr-panel" data-reveal><div><span class="card-category">01 / Scan & give</span><h3 class="mt-3 text-3xl">A simple way to help.</h3><p class="mt-5 max-w-md text-sm text-muted">Scan the donation QR code with a compatible payment app. If you are using this phone to browse, save the QR image and open it in an app that supports scanning from your photos.</p><a class="button button-dark mt-7" href={url(donation.qr.src)} download="Navajeevan-Seva-Trust-donation-QR.jpeg">Save donation QR <Icon name="arrow"/></a></div><a class="qr-image-link" href={url(donation.qr.src)} aria-label="Open the donation QR image"><img src={url(donation.qr.src)} alt="Bharat QR donation code for Navajeevan Seva Trust" width={donation.qr.width} height={donation.qr.height} loading="lazy" decoding="async" class="donation-qr"/></a></div>
    <div class="mb-7 mt-14" data-reveal><p class="card-category">02 / Bank transfer</p><h3 class="text-3xl">Bank details for donations</h3></div>
    <div class="bank-grid">{donation.accounts.map((account, index) => <article class="bank-card" data-reveal data-reveal-delay={index * 100}><p class="card-category">{account.bank}</p><h4>{account.holder}</h4><dl><div><dt>Account number</dt><dd class="bank-number">{account.number}</dd></div><div><dt>IFSC code</dt><dd class="font-semibold tracking-wide">{account.ifsc}</dd></div><div><dt>Branch</dt><dd>{account.branch}</dd></div></dl></article>)}</div>
  </section>

  <section class="container pb-16"><div class="join-banner" data-reveal><div><p class="eyebrow">We’re here to help</p><h2>Let’s make your gift personal.</h2><p class="max-w-xl">For meal sponsorship dates, contribution enquiries, or receipt information, contact Navajeevan Seva Trust directly.</p><div class="mt-6 flex flex-wrap gap-x-6 gap-y-3">{site.phones.map(phone => <a class="text-link text-saffron hover:text-white" href={phone.href}><Icon name="phone"/>{phone.label}</a>)}</div><a class="mt-4 block text-sm text-white underline underline-offset-4 [overflow-wrap:anywhere]" href={`mailto:${site.emails[0]}`}>{site.emails[0]}</a></div><div><a class="button button-saffron" href={url('contact/')}>Contact the Ashram <Icon name="arrow"/></a></div></div></section>
</Layout>
<style>
  .donation-intro { display: grid; grid-template-columns: 1.05fr .95fr; gap: 64px; align-items: center; }
  .donation-intro h1 { font-size: clamp(2.7rem,4.5vw,4.4rem); }
  .sponsorship-grid, .bank-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 24px; }
  .sponsorship-card { display:flex; flex-direction:column; background:#faf8f1; padding:28px; border:1px solid #203e321a; border-radius:18px; }
  .sponsorship-prices { margin-top:auto; padding-top:24px; }
  .sponsorship-prices > div { border-top:1px solid #203e3220; padding-top:16px; margin-top:16px; }
  .sponsorship-prices dt { font-size:12px; color:#5c685f; }
  .sponsorship-prices dd { display:flex; flex-wrap:wrap; align-items:baseline; gap:8px; margin-top:6px; }
  .sponsorship-prices strong { font-family:var(--font-serif); font-size:28px; font-weight:400; }
  .sponsorship-prices span { font-size:12px; color:#5c685f; }
  .donation-qr-panel { display:grid; grid-template-columns:1fr 1fr; align-items:center; gap:48px; padding:40px; background:#eeeee3; border-radius:24px; }
  .qr-image-link { display:block; width:100%; max-width:384px; justify-self:center; background:white; border-radius:12px; overflow:hidden; }
  .donation-qr { display:block; width:100%; height:auto; object-fit:contain; }
  .bank-card { padding:28px; border:1px solid #203e3226; border-radius:18px; background:#fffdf8; }
  .bank-card h4 { font-size:24px; line-height:1.3; }
  .bank-card dl { margin-top:24px; display:grid; gap:20px; }
  .bank-card dt { font-size:11px; color:#5c685f; margin-bottom:5px; }
  .bank-card dd { font-size:14px; overflow-wrap:anywhere; }
  .bank-card .bank-number { font-size:18px; font-weight:600; font-variant-numeric:tabular-nums; user-select:all; }
  @media(max-width:1023px) { .donation-intro { gap:32px; } .sponsorship-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } .bank-grid { grid-template-columns:1fr; } }
  @media(max-width:767px) { .donation-intro, .donation-qr-panel, .sponsorship-grid { grid-template-columns:1fr; } .donation-qr-panel { padding:24px; gap:32px; } }
</style>
