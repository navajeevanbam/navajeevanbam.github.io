---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { site } from '../config';
import { contact } from '../config/contact';

---
<Layout title="Get in touch" description={`Start a conversation with ${site.name}. Explore volunteering, visits, community partnerships, and ways to care together.`} active="contact/">
  <PageIntro eyebrow="Our door is always open" title="Good things begin with a hello." description="Have a question, an idea, or a little time to share? We would love to make room for you in our community."/>
  <section class="container section-space"><div class="grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-20"><div data-reveal><p class="eyebrow">Let’s connect</p><h2>There is a place<br/>for you here.</h2><p class="mt-5 text-sm text-muted">Whether you are exploring volunteering, hoping to visit, or interested in supporting an initiative, a conversation is a lovely place to start.</p><div class="mt-8 space-y-6">{[{icon:'pin',label:'Find our community',value:site.addressLines.join(', '),note:''},{icon:'clock',label:'Plan a visit',value:site.visiting,note:'Contact us to arrange your visit.'}].map(item => <div class="flex items-start gap-4"><span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#e9e9dc]"><Icon name={item.icon}/></span><div><h3 class="font-sans text-sm font-semibold tracking-normal">{item.label}</h3><p class="mt-1 text-sm text-muted">{item.value}</p>{item.note && <p class="mt-1 text-xs text-muted">{item.note}</p>}</div></div>)}<div><h3 class="font-sans text-sm font-semibold tracking-normal">Call us</h3>{site.phones.map(phone => <a class="mt-2 block text-sm underline underline-offset-4" href={phone.href}>{phone.label}</a>)}</div><div><h3 class="font-sans text-sm font-semibold tracking-normal">Write to us</h3>{site.emails.map(email => <a class="mt-2 block break-all text-sm underline underline-offset-4" href={`mailto:${email}`}>{email}</a>)}</div></div><Photo name="volunteers" class="mt-9 aspect-[1.8] w-full rounded-2xl"/></div>
    <div class="content-card h-fit p-6 sm:p-9" data-reveal data-reveal-delay="250"><div id="contact-entry"><h2 class="text-3xl">Send a little hello.</h2><p class="mt-3 text-sm text-muted">Fields marked * are required. Email is optional.</p><form id="contact-form" data-endpoint={contact.endpointUrl} data-access-key={contact.accessKey} data-timeout={contact.timeoutMs} class="mt-7"><fieldset class="space-y-5"><legend class="sr-only">Your contact details and message</legend><div><label class="form-label" for="contact-name">Your name *</label><input id="contact-name" name="name" class="form-input" type="text" required maxlength="100" autocomplete="name" placeholder="How should we address you?"/></div><div><label class="form-label" for="contact-phone">Mobile Number *</label><input id="contact-phone" name="phone" class="form-input" type="tel" inputmode="tel" required maxlength="25" autocomplete="tel" aria-describedby="phone-help" placeholder="98765 43210"/><p id="phone-help" class="mt-2 text-xs text-muted">10-digit Indian mobile number. You may include +91.</p></div><div><label class="form-label" for="contact-email">Email address (optional)</label><input id="contact-email" name="email" class="form-input" type="email" maxlength="254" autocomplete="email" placeholder="you@example.com"/></div><div><label class="form-label" for="contact-subject">What brings you here? *</label><select id="contact-subject" name="subject" class="form-input" required><option value="">Choose a topic</option><option>Volunteering</option><option>Supporting a program</option><option>Planning a visit</option><option>Community partnership</option><option>Something else</option></select></div><div><label class="form-label" for="contact-message">Your message *</label><textarea id="contact-message" name="message" class="form-input min-h-36 resize-y" required maxlength="3000" placeholder="Tell us a little about what you have in mind…"></textarea></div></fieldset><button type="submit" class="button button-dark mt-6 w-full" disabled>Send message</button><div id="contact-result" class="form-result" role="alert" tabindex="-1" hidden><p id="contact-error-text"></p><div id="contact-alternatives" class="mt-3 space-y-2" hidden>{site.phones.map(phone => <a class="block underline" href={phone.href}>Call {phone.label}</a>)}{site.emails.map(email => <a class="block break-all underline" href={`mailto:${email}`}>Email {email}</a>)}</div></div><noscript><p class="demo-note mt-5">Enable JavaScript to send this form, or <a class="underline" href={site.phones[0].href}>call us</a> or <a class="underline" href={`mailto:${site.emails[0]}`}>email us</a>.</p></noscript></form></div><div id="contact-success" hidden><Icon name="check" class="mb-5 size-10"/><h2 class="text-3xl" tabindex="-1">Thank you. Your message has been sent.</h2><p class="mt-4 text-sm text-muted">Thank you for getting in touch with Navajeevan Seva Ashram.</p><button id="contact-again" type="button" class="button button-dark mt-7">Send another message</button></div></div>
  </div></section>
  <section class="container pb-18"><div class="rounded-3xl bg-[#efeee4] px-7 py-10 text-center md:px-14" data-reveal><Icon name="heart" class="mx-auto mb-5 size-7 text-[#936c29]"/><h2 class="text-3xl">However you show up, bring yourself.</h2><p class="mx-auto mt-4 max-w-xl text-sm text-muted">Your interests, your experience, your questions, your kindness. Communities are stronger when there is room for all of them.</p></div></section>
</Layout>
<script>
  import '../scripts/contact';
</script>
<style>
  #contact-result { background:#fff1e8; border-color:#b87559; color:#783d25; }
</style>
