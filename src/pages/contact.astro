---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { site } from '../config';

---
<Layout title="Get in touch" description={`Start a conversation with ${site.name}. Explore volunteering, visits, community partnerships, and ways to care together.`} active="contact/">
  <PageIntro eyebrow="Our door is always open" title="Good things begin with a hello." description="Have a question, an idea, or a little time to share? We would love to make room for you in our community."/>
  <section class="container section-space"><div class="grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-20"><div data-reveal><p class="eyebrow">Let’s connect</p><h2>There is a place<br/>for you here.</h2><p class="mt-5 text-sm text-muted">Whether you are exploring volunteering, hoping to visit, or interested in supporting an initiative, a conversation is a lovely place to start.</p><div class="mt-8 space-y-6">{[{icon:'pin',label:'Find our community',value:site.addressLines.join(', '),note:''},{icon:'clock',label:'Plan a visit',value:site.visiting,note:'Contact us to arrange your visit.'}].map(item => <div class="flex items-start gap-4"><span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#e9e9dc]"><Icon name={item.icon}/></span><div><h3 class="font-sans text-sm font-semibold tracking-normal">{item.label}</h3><p class="mt-1 text-sm text-muted">{item.value}</p>{item.note && <p class="mt-1 text-xs text-muted">{item.note}</p>}</div></div>)}<div><h3 class="font-sans text-sm font-semibold tracking-normal">Call us</h3>{site.phones.map(phone => <a class="mt-2 block text-sm underline underline-offset-4" href={phone.href}>{phone.label}</a>)}</div><div><h3 class="font-sans text-sm font-semibold tracking-normal">Write to us</h3>{site.emails.map(email => <a class="mt-2 block break-all text-sm underline underline-offset-4" href={`mailto:${email}`}>{email}</a>)}</div></div><Photo name="volunteers" class="mt-9 aspect-[1.8] w-full rounded-2xl"/></div>
    <div class="content-card h-fit p-6 sm:p-9" data-reveal data-reveal-delay="250"><h2 class="text-3xl">Send a little hello.</h2><p class="mt-3 text-sm text-muted">Try our example enquiry form. Fields marked * are required.</p><p class="demo-note mt-5">Demo form: information stays in this page. No message is sent or stored.</p><form id="contact-form" data-demo-form class="mt-7 space-y-5"><div><label class="form-label" for="contact-name">Your name *</label><input id="contact-name" class="form-input" type="text" required maxlength="100" autocomplete="name" placeholder="How should we address you?"/></div><div><label class="form-label" for="contact-email">Email address *</label><input id="contact-email" class="form-input" type="email" required maxlength="254" autocomplete="email" placeholder="you@example.com"/></div><div><label class="form-label" for="contact-subject">What brings you here? *</label><select id="contact-subject" class="form-input" required><option value="">Choose a topic</option><option>Volunteering</option><option>Supporting a program</option><option>Planning a visit</option><option>Community partnership</option><option>Something else</option></select></div><div><label class="form-label" for="contact-message">Your message *</label><textarea id="contact-message" class="form-input min-h-36 resize-y" required minlength="10" maxlength="3000" placeholder="Tell us a little about what you have in mind…"></textarea><p class="mt-2 text-xs text-muted">Please use at least 10 characters.</p></div><button type="submit" class="button button-dark w-full" disabled>Preview my enquiry <Icon name="arrow"/></button><p id="contact-result" class="form-result" role="status" hidden></p><noscript><p class="demo-note">Enable JavaScript to try this local contact form demo.</p></noscript></form></div>
  </div></section>
  <section class="container pb-18"><div class="rounded-3xl bg-[#efeee4] px-7 py-10 text-center md:px-14" data-reveal><Icon name="heart" class="mx-auto mb-5 size-7 text-[#936c29]"/><h2 class="text-3xl">However you show up, bring yourself.</h2><p class="mx-auto mt-4 max-w-xl text-sm text-muted">Your interests, your experience, your questions, your kindness. Communities are stronger when there is room for all of them.</p></div></section>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const result = document.querySelector<HTMLElement>('#contact-result')!;
  const name = document.querySelector<HTMLInputElement>('#contact-name')!;
  const message = document.querySelector<HTMLTextAreaElement>('#contact-message')!;
  form.querySelector<HTMLButtonElement>('button[type="submit"]')!.disabled = false;
  form.addEventListener('input', () => { name.setCustomValidity(''); message.setCustomValidity(''); result.hidden = true; });
  form.addEventListener('submit', event => {
    event.preventDefault();
    name.setCustomValidity(name.value.trim() ? '' : 'Please enter your name.');
    message.setCustomValidity(message.value.trim().length >= 10 ? '' : 'Please write at least 10 characters of your message.');
    if (!form.reportValidity()) return;
    result.textContent = 'Thank you for trying our enquiry form. Demo only—no message was sent or stored. Please call or email us using the contact details on this page.';
    form.reset(); result.hidden = false;
  });
</script>
