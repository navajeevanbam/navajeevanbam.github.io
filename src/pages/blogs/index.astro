---
import { site } from '../../config';
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageIntro from '../../components/PageIntro.astro';
import BlogCard from '../../components/BlogCard.astro';
import JoinBanner from '../../components/JoinBanner.astro';
const blogs = (await getCollection('blogs')).sort((a,b) => +b.data.date - +a.data.date);
---
<Layout title="Stories from our community" description={`Read thoughtful stories about everyday kindness, shared meals, learning, volunteering, and the spirit of ${site.name}.`} active="blogs/">
  <PageIntro eyebrow="Notes from our community" title="Little stories. A lot of heart." description="Reflections on kindness, connection, and the everyday moments that remind us what it means to care."/>
  <section class="container section-space"><div class="mb-9 flex flex-wrap items-center justify-between gap-4"><p class="eyebrow mb-0">The community journal</p><p class="text-xs text-muted">Sample editorial stories · A glimpse of our values</p></div><div class="grid gap-x-8 gap-y-14 md:grid-cols-2 lg:grid-cols-3">{blogs.map(blog => <BlogCard blog={blog}/>)}</div></section><JoinBanner/>
</Layout>
